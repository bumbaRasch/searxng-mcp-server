{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "node_modules", ".agents", "coverage", ".superpowers", "docs"],
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "env": { "vitest": true }
    }
  ]
}
