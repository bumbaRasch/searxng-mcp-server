# Copy to .env and set a random secret: openssl rand -hex 32
#
# .env is read ONLY by Docker Compose (for SEARXNG_SECRET).
# The MCP server does NOT load .env — its configuration (SEARXNG_URL, etc.)
# is supplied by the MCP client via the `environment` block.
SEARXNG_SECRET=change_me
#
# Optional MCP server settings (also supplied via the client's `environment` block):
#   SEARXNG_URLS=http://searx1:8888,http://searx2:8888  # failover instances, tried in order; SEARXNG_URL stays primary
#   SEARXNG_CACHE_TTL_MS=0                              # response cache TTL in ms; 0 = off (default)
